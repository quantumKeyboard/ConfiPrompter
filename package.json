{
  "name": "confiprompter",
  "productName": "ConfiPrompter",
  "version": "2.0.0",
  "description": "Compact, screen-share-invisible desktop teleprompter with voice-reactive scrolling",
  "author": "ConfiPrompter",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "icons": "node scripts/generate-icons.js"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "mammoth": "^1.8.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^44.9.3",
    "electron-builder": "^26.0.12",
    "electron-reload": "^1.5.0"
  },
  "build": {
    "appId": "com.confiprompter.app",
    "productName": "ConfiPrompter",
    "files": [
      "**/*",
      "!build/**/*",
      "!dist/**/*",
      "!scripts/**/*",
      "!teleprompter_project.md"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "ConfiPrompter listens for your voice (locally, nothing is recorded) to scroll the script while you speak."
      }
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage"
      ]
    },
    "icon": "assets/icon.png"
  }
}
